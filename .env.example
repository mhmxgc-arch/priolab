# On APP-01 as /root/stacks/priolab/.env (mode 600, never committed).
# Required -- encrypts every user's TOTP secret. Generate once, keep a copy in
# C:\DEV\_SECRETS\priolab.env; losing it means re-enrolling every user.
APP_ENCRYPTION_KEY=
# Optional; compose has these defaults.
PUBLIC_HOST=priolab.xprsit.net
TZ=Asia/Jerusalem
